# Copy this file to .env and replace all required values before starting Compose.
APP_GLOBAL_SECRET=replace-with-a-long-random-secret
FRP_PANEL_IMAGE=ghcr.io/yunj-yun/frp-web-panel:replace-with-release-tag
MASTER_API_HOST=master.example.com
MASTER_RPC_HOST=master.example.com
CLIENT_API_URL=http://master.example.com:9000
CLIENT_RPC_URL=grpc://master.example.com:9001

# Optional overrides.
# COMPOSE_PROJECT_NAME=frp-panel
# FRP_PANEL_CONTAINER_NAME=frp-panel-master
# MASTER_WEB_PORT=9000
# MASTER_RPC_PORT=9001
# MASTER_API_SCHEME=https
